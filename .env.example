# Set to enable production POS server mode (required for real multi-device / ledger).
# Leave unset for local-only demo (browser localStorage).
PUBLIC_POS_API_URL=http://localhost:8000

# Guest order QR / share link (production menu URL). When unset, QR uses the current site origin + /order.
# PUBLIC_GUEST_ORDER_URL=https://order.your-restaurant.example/order
# Guest Order Now → kitchen tickets requires PUBLIC_POS_API_URL (Phase B).

# Optional — shown to the SPA when using Stripe.js (server still needs STRIPE_SECRET_KEY).
# PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Pilot tip: start the API with Docker Compose (`docker compose up -d`) so data
# lives on the `pos-data` volume, then point this URL at that API origin.
