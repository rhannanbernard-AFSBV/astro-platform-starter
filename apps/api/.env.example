PORT=4000
NODE_ENV=development
# OMNI_ENV=production  # set with NODE_ENV=production to require strong JWT_SECRET

# Leave DATABASE_URL empty to use embedded PGlite (./data/omniclean.pglite)
DATABASE_URL=
OPENAI_API_KEY=
DEFAULT_TENANT_ID=1
PGLITE_DATA_DIR=./data/omniclean.pglite

# Auth — production REQUIRES a strong secret (≥32 chars). Never commit real secrets.
# Local/dev: omit JWT_SECRET and a strong secret is auto-written to data/.jwt_secret (gitignored)
# Or set: JWT_SECRET=$(openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRES=7d
# ALLOW_INSECURE_JWT=true  # test runners only — do not use in shared/prod

PUBLIC_APP_URL=http://localhost:4000

EMAIL_FROM=OmniClean Proposals <proposals@omniclean.demo>
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
