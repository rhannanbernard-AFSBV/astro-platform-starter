PORT=4000
# Leave DATABASE_URL empty to use embedded PGlite (./data/omniclean.pglite)
# Or point at PostgreSQL: postgres://user:pass@localhost:5432/omniclean
DATABASE_URL=
OPENAI_API_KEY=
DEFAULT_TENANT_ID=1
PGLITE_DATA_DIR=./data/omniclean.pglite

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES=7d

# Public base URL for e-sign links in emails (no trailing slash)
PUBLIC_APP_URL=http://localhost:4000

# Outbound email — first match wins: Resend → SendGrid → SMTP → dry_run console
EMAIL_FROM=OmniClean Proposals <proposals@omniclean.demo>
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
