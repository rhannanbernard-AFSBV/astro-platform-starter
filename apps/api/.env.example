# =============================================================================
# OmniClean API — environment checklist
# Copy to .env locally. On Railway, set the same keys in Variables (never commit).
# =============================================================================

PORT=4000
NODE_ENV=development
# Production: set BOTH
# NODE_ENV=production
# OMNI_ENV=production

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave empty for embedded PGlite (./data/omniclean.pglite) — fine for demos.
# Production: Postgres connection string (Railway Postgres plugin recommended).
DATABASE_URL=
PGLITE_DATA_DIR=./data/omniclean.pglite
# PGlite RLS: auto-probed. Force off if set_config/RLS misbehaves in embedded mode.
# PGLITE_RLS=false
# DEFAULT_TENANT_ID is no longer used for open register (requires company_name or invite_code).
# ALLOW_OPEN_REGISTER_DEFAULT_TENANT=true  # dangerous — local demos only

# ---------------------------------------------------------------------------
# Demo seed (demo@omniclean.demo / demo1234, is_master)
# ---------------------------------------------------------------------------
# Skipped automatically when NODE_ENV or OMNI_ENV is production.
# ALLOW_DEMO_SEED=true   # force seed even in production (never on shared prod)
# ALLOW_DEMO_SEED=false  # force skip even in development

# ---------------------------------------------------------------------------
# Auth / JWT (REQUIRED in production — ≥32 chars)
# ---------------------------------------------------------------------------
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES=7d
# ALLOW_INSECURE_JWT=true  # test runners only — never in shared/prod

# ---------------------------------------------------------------------------
# Public URLs / CORS
# ---------------------------------------------------------------------------
# Base URL used in proposal emails and portal links
PUBLIC_APP_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API (required for prod SPA/Expo web)
# Example: https://app.omniclean.example,https://omniclean.example,http://localhost:8081
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# OpenAI vision (live GPT-4o path)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Production defaults: mock vision OFF. Dev: mock allowed when key missing.
# ALLOW_MOCK_VISION=true   # force allow mock demos in prod
# ALLOW_MOCK_VISION=false  # force require OpenAI even in dev

# ---------------------------------------------------------------------------
# Email — first configured wins: Resend → SendGrid → SMTP
# ---------------------------------------------------------------------------
EMAIL_FROM=OmniClean Proposals <proposals@omniclean.demo>
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Production defaults: dry_run OFF (send fails with EMAIL_PROVIDER_MISSING).
# ALLOW_EMAIL_DRY_RUN=true     # allow console-only dry run in prod demos
# REQUIRE_EMAIL_PROVIDER=true  # force real provider even in development

# ---------------------------------------------------------------------------
# Proposal / static file security
# ---------------------------------------------------------------------------
# Days until /p/:token portal links expire (default 30)
PROPOSAL_TOKEN_TTL_DAYS=30
# Email OTP required before e-sign (default true). After sign, portal link cannot re-sign.
# PROPOSAL_SIGN_REQUIRE_OTP=true
# PROPOSAL_SIGN_ALLOW_OTP_ON_SIGN=true
# PROPOSAL_SIGN_OTP_TTL_MS=900000
# PROPOSAL_SIGN_TOKEN_TTL_MS=600000
# Optional HMAC key for /qa-photos|/signatures|/insurance signed URLs (defaults to JWT_SECRET)
# FILE_URL_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Nominatim geocode (address → geofence)
# ---------------------------------------------------------------------------
# Public OSM Nominatim by default. Hosted envs must allow HTTPS egress to this host
# (Railway / firewall allowlist). Use a self-hosted mirror via NOMINATIM_URL if needed.
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Comma-separated allowed hostnames (defaults to NOMINATIM_URL host)
# NOMINATIM_ALLOWLIST=nominatim.openstreetmap.org
# NOMINATIM_TIMEOUT_MS=8000
# NOMINATIM_USER_AGENT=OmniCleanAIScanner/0.1 (ops geofence; contact ops)
# Manual pin always works: POST /api/bids/:id/geofence/from-address with center_lat/center_lng

# Max GPT-4o walkthrough frames per scan (default 8, max 12)
# VISION_MAX_FRAMES=8

# ---------------------------------------------------------------------------
# FX refresh job (non-peg currencies)
# ---------------------------------------------------------------------------
# Optional JSON feed: { "rates": { "EUR": 0.92, "CAD": 1.36, "GBP": 0.79 } }
# FX_REFRESH_URL=
# Run: npm run fx:refresh   |   npm run fx:refresh:dry

# ---------------------------------------------------------------------------
# Rate limits (requests per 15-minute window)
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_API_MAX=300
RATE_LIMIT_SCAN_MAX=40
RATE_LIMIT_PUBLIC_MAX=120
