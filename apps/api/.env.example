# =============================================================================
# OmniClean API — environment checklist
# Copy to .env locally. On Railway, set the same keys in Variables (never commit).
# =============================================================================

PORT=4000
NODE_ENV=development
# Production: set BOTH
# NODE_ENV=production
# OMNI_ENV=production

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave empty for embedded PGlite (./data/omniclean.pglite) — fine for demos.
# Production: Postgres connection string (Railway Postgres plugin recommended).
DATABASE_URL=
PGLITE_DATA_DIR=./data/omniclean.pglite
DEFAULT_TENANT_ID=1

# ---------------------------------------------------------------------------
# Auth / JWT (REQUIRED in production — ≥32 chars)
# ---------------------------------------------------------------------------
# Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES=7d
# ALLOW_INSECURE_JWT=true  # test runners only — never in shared/prod

# ---------------------------------------------------------------------------
# Public URLs / CORS
# ---------------------------------------------------------------------------
# Base URL used in proposal emails and portal links
PUBLIC_APP_URL=http://localhost:4000
# Comma-separated browser origins allowed to call the API (required for prod SPA/Expo web)
# Example: https://app.omniclean.example,https://omniclean.example,http://localhost:8081
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# OpenAI vision (live GPT-4o path)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# Production defaults: mock vision OFF. Dev: mock allowed when key missing.
# ALLOW_MOCK_VISION=true   # force allow mock demos in prod
# ALLOW_MOCK_VISION=false  # force require OpenAI even in dev

# ---------------------------------------------------------------------------
# Email — first configured wins: Resend → SendGrid → SMTP
# ---------------------------------------------------------------------------
EMAIL_FROM=OmniClean Proposals <proposals@omniclean.demo>
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Production defaults: dry_run OFF (send fails with EMAIL_PROVIDER_MISSING).
# ALLOW_EMAIL_DRY_RUN=true     # allow console-only dry run in prod demos
# REQUIRE_EMAIL_PROVIDER=true  # force real provider even in development

# ---------------------------------------------------------------------------
# Proposal security
# ---------------------------------------------------------------------------
# Days until /p/:token portal links expire (default 30)
PROPOSAL_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Rate limits (requests per 15-minute window)
# ---------------------------------------------------------------------------
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_API_MAX=300
RATE_LIMIT_SCAN_MAX=40
RATE_LIMIT_PUBLIC_MAX=120
