# Copy to .env and adjust. Never commit real secrets.

# --- Docker Postgres (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=allyanna
POSTGRES_PORT=5432

# Migrator connection (superuser / role that can CREATE ROLE + tables)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/allyanna

# Password assigned to allyanna_app_user during migration (required by 001_*.sql)
ALLYANNA_APP_PASSWORD=change-me-strong-secret

# App runtime connection (least-privilege role after migration)
ALLYANNA_DATABASE_URL=postgresql://allyanna_app_user:change-me-strong-secret@localhost:5432/allyanna

# Optional discrete alternative to ALLYANNA_DATABASE_URL:
# ALLYANNA_DB_HOST=localhost
# ALLYANNA_DB_PORT=5432
# ALLYANNA_DB_USER=allyanna_app_user
# ALLYANNA_DB_PASSWORD=change-me-strong-secret
# ALLYANNA_DB_NAME=allyanna

# OpenAI (live chat + OCR only; unit tests do not call the API)
# Desktop: prefer %LOCALAPPDATA%\Allyanna\config.json → {"openai_api_key":"..."}
OPENAI_API_KEY=

# --- Windows / local desktop (embedded SQLite) ---
# ALLYANNA_LOCAL_MODE=1
# ALLYANNA_DB_ENGINE=sqlite
# Optional overrides (defaults: %LOCALAPPDATA%\Allyanna\allyanna_ledger.db)
# ALLYANNA_DATA_DIR=
# ALLYANNA_SQLITE_PATH=
# ALLYANNA_CONFIG_PATH=
# ALLYANNA_UI_DIR=
# ALLYANNA_HOST=127.0.0.1
# ALLYANNA_PORT=8000
