# Local defaults only. Replace passwords and API keys before any shared or production deploy.
# Demo Bearer keys from the local seed (allyanna-dev-key / allyanna-other-key) are not production auth.
# For production compose, copy ../.env.production.example → .env.production (never commit secrets).

# --- Allyanna accounting API ---
ALLYANNA_ENV=development
DATABASE_URL=postgresql://allyanna_app:allyanna_app_dev@127.0.0.1:5432/allyanna
TAX_CACHE_TTL_SECONDS=300
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Comma-separated desk origins. Empty → local defaults in development.
# Production requires an explicit list (no *).
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# false to exercise production blocking of allyanna-dev-key / allyanna-other-key locally.
# Production always blocks demo keys regardless of this flag.
ALLOW_DEMO_API_KEYS=true

# --- Savory POS API (app.main:app / Dockerfile.pos) ---
POS_DATA_DIR=./data
POS_SESSION_TTL_HOURS=12
POS_SESSION_IDLE_MINUTES=30
POS_CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# PIN hardening
POS_PIN_MAX_ATTEMPTS=5
POS_PIN_WINDOW_SECONDS=300
POS_PIN_LOCKOUT_SECONDS=900
# Force seeded demo staff to rotate PINs (recommended for pilots)
POS_FORCE_PIN_CHANGE=1
# Hide demo PIN hints in the SPA config payload
POS_HIDE_DEMO_CREDENTIALS=1

# Optional Stripe (card rails). Leave unset for cash / manual-card only.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional OpenAI — GPT-4o menu enrich (prep / pairings / ingredients). No money math.
# OPENAI_MENU_MODEL=gpt-4o

# Tenant bootstrap (defaults to demo restaurant tenant)
# POS_DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111
