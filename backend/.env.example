# POS API
POS_DATA_DIR=./data
POS_SESSION_TTL_HOURS=12
POS_SESSION_IDLE_MINUTES=30
POS_CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# PIN hardening
POS_PIN_MAX_ATTEMPTS=5
POS_PIN_WINDOW_SECONDS=300
POS_PIN_LOCKOUT_SECONDS=900
# Force seeded demo staff to rotate PINs (recommended for pilots)
POS_FORCE_PIN_CHANGE=1
# Hide demo PIN hints in the SPA config payload
POS_HIDE_DEMO_CREDENTIALS=1

# Optional Stripe (card rails). Leave unset for cash / manual-card only.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional OpenAI — GPT-4o menu enrich (prep / pairings / ingredients). No money math.
# OPENAI_API_KEY=sk-...
# OPENAI_MENU_MODEL=gpt-4o

# Tenant bootstrap (defaults to demo restaurant tenant)
# POS_DEFAULT_TENANT_ID=11111111-1111-1111-1111-111111111111
