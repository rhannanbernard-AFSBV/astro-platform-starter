# Allyanna Accounting — production environment template
# Copy to `.env.production` and fill every value at deploy time.
#   cp .env.production.example .env.production
# Never commit `.env.production` (gitignored). No real secrets belong here.

# --- Runtime ---
NODE_ENV=production

# --- Public edge ---
# Host ports published by nginx (optional overrides)
ALLYANNA_HTTP_PORT=80
ALLYANNA_HTTPS_PORT=443
# Browser → API origin (client calls /api/v1/...; nginx proxies /api/ → FastAPI).
# No trailing slash. Do not append /api — paths already include it.
NEXT_PUBLIC_API_BASE_URL=https://your-domain.example

# --- PostgreSQL (isolated compose service; not exposed on the host) ---
POSTGRES_USER=allyanna
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=allyanna

# Migrator / bootstrap connection (superuser or role that can apply migrations).
# Host `postgres` is the compose service name on the internal network.
DATABASE_URL=postgresql://allyanna:replace-with-strong-postgres-password@postgres:5432/allyanna

# Password assigned to least-privilege role `allyanna_app_user` during migration.
ALLYANNA_APP_PASSWORD=replace-with-strong-app-role-password

# App runtime DB URL (Pillar 1 RLS — every query scoped by tenant_id).
# Prefer allyanna_app_user after migrations; never hardcode in images.
ALLYANNA_DATABASE_URL=postgresql://allyanna_app_user:replace-with-strong-app-role-password@postgres:5432/allyanna

# Optional discrete DB vars (alternative to ALLYANNA_DATABASE_URL):
# ALLYANNA_DB_HOST=postgres
# ALLYANNA_DB_PORT=5432
# ALLYANNA_DB_USER=allyanna_app_user
# ALLYANNA_DB_PASSWORD=replace-with-strong-app-role-password
# ALLYANNA_DB_NAME=allyanna

# --- Auth / secrets (runtime only) ---
# HS256 (or similar) signing secret for JWT verification — generate a long random value.
JWT_SECRET=replace-with-long-random-jwt-secret

# OpenAI — LLM extraction / routing / OCR only. Never used for financial math.
# Tax, TOT, wage tax, and SZV are computed in Python with decimal + DB tax tables (SXM).
OPENAI_API_KEY=replace-with-openai-api-key

# Optional model overrides (defaults are set in application code if unset)
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_OCR_MODEL=gpt-4o

# --- Sint Maarten compliance defaults (non-secret) ---
ALLYANNA_COUNTRY_CODE=SXM
# Tax rates/brackets/SZV caps are loaded from DB (tax_year + country_code), not formula literals.
