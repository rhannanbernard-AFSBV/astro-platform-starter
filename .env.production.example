# Allyanna production / staging secrets — COPY to .env.production and fill in.
# NEVER commit real values. NEVER invent production secrets in git.

# --- Postgres bootstrap (compose postgres service) ---
POSTGRES_USER=allyanna
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=allyanna

# Superuser/owner URL used only by migrate_prod.sh
DATABASE_URL=postgresql://allyanna:REPLACE_WITH_STRONG_DB_PASSWORD@postgres:5432/allyanna

# App role password (least privilege; migrate sets allyanna_app)
ALLYANNA_APP_PASSWORD=REPLACE_WITH_STRONG_APP_ROLE_PASSWORD

# Runtime URL used by FastAPI (allyanna_app role)
ALLYANNA_DATABASE_URL=postgresql://allyanna_app:REPLACE_WITH_STRONG_APP_ROLE_PASSWORD@postgres:5432/allyanna

# --- API ---
ALLYANNA_ENV=production
OPENAI_API_KEY=REPLACE_WITH_REAL_OPENAI_KEY
OPENAI_MODEL=gpt-4o
TAX_CACHE_TTL_SECONDS=300

# Explicit desk origins only. No * and no bare local defaults in production.
CORS_ORIGINS=https://desk.example.com

# Must stay false for live. true only for disposable staging that needs dual-firm seed.
ALLYANNA_SEED_DEMO=false
ALLOW_DEMO_API_KEYS=false

# Browser-facing API base (nginx TLS origin that proxies /api/)
NEXT_PUBLIC_API_BASE_URL=https://desk.example.com

ALLYANNA_HTTPS_PORT=443
ALLYANNA_HTTP_PORT=80
